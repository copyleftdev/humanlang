FROM mcr.microsoft.com/dotnet/sdk:8.0
LABEL org.opencontainers.image.description="Human Lang - F# Implementation"

WORKDIR /app
COPY fsharp/RateLimiter.fs .

# Create a minimal F# project
RUN dotnet new console -lang F# -n RateLimiter -o . --force && \
    rm Program.fs && \
    mv RateLimiter.fs Program.fs && \
    dotnet build -c Release

CMD ["dotnet", "run", "-c", "Release"]
